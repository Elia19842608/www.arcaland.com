---
// Tavola 1: planimetria di esempio 20 × 16 m con tre zone di sicurezza
---
<svg viewBox="0 0 620 520" role="img" aria-labelledby="d1-t" class="disegno">
  <title id="d1-t">Esempio di progetto: area gioco di 20 per 16 metri con tre zone di sicurezza</title>
  <g class="quota">
    <line class="disegna" pathLength="1" x1="60" y1="30" x2="580" y2="30" />
    <line class="disegna" pathLength="1" x1="30" y1="60" x2="30" y2="480" />
    <text x="320" y="20" text-anchor="middle">20,00 m</text>
    <text x="22" y="270" text-anchor="middle" transform="rotate(-90 22 270)">16,00 m</text>
  </g>
  <rect class="lotto compare" style="--i:0" x="60" y="60" width="520" height="420" rx="6" />
  <g class="compare" style="--i:1">
    <rect class="zona" x="110" y="110" width="200" height="150" rx="5" />
    <rect class="pezzo" x="160" y="150" width="100" height="70" />
    <text class="etichetta" x="210" y="245" text-anchor="middle">Altalena doppia</text>
  </g>
  <g class="compare" style="--i:2">
    <rect class="zona" x="350" y="100" width="190" height="130" rx="5" />
    <polygon class="oro" points="445,130 480,150 480,190 445,210 410,190 410,150" />
    <text class="etichetta" x="445" y="225" text-anchor="middle">Hexaplay</text>
  </g>
  <g class="compare" style="--i:3">
    <rect class="zona" x="130" y="300" width="380" height="140" rx="5" />
    <rect class="pezzo" x="200" y="345" width="240" height="50" />
    <text class="etichetta" x="320" y="425" text-anchor="middle">Percorso equilibrio</text>
  </g>
</svg>
