---
// Tavola 5: linea del tempo di dieci anni
const anni = Array.from({ length: 11 }, (_, i) => i);
---
<svg viewBox="0 190 620 210" role="img" aria-labelledby="d5-t" class="disegno">
  <title id="d5-t">Linea del tempo di dieci anni: posa, poi ispezioni periodiche e manutenzione con lo stesso interlocutore</title>
  <line class="asse disegna" pathLength="1" x1="40" y1="300" x2="580" y2="300" />
  {anni.map((a) => (
    <g>
      <line class="tacca" x1={40 + a * 54} y1="290" x2={40 + a * 54} y2="310" />
      <text class="anno" x={40 + a * 54} y="340" text-anchor="middle">{a === 0 ? 'Posa' : `${a}`}</text>
    </g>
  ))}
  <polygon class="oro compare" style="--i:0" points="40,240 58,250 58,270 40,280 22,270 22,250" />
  {anni.slice(1).map((a, i) => (
    <circle class="ispezione compare" style={`--i:${i + 1}`} cx={40 + a * 54} cy="260" r="9" />
  ))}
  <text class="etichetta" x="40" y="215" text-anchor="start">Consegna</text>
  <text class="etichetta" x="580" y="215" text-anchor="end">Ispezioni periodiche documentate</text>
  <text class="nota" x="580" y="380" text-anchor="end">Anni dalla posa</text>
</svg>
