---
// Tavola 4: punti di controllo numerati
const punti = [
  { n: 4, x: 330, y: 200, lato: 'd', ly: 160, righe: ['Usura, giunzioni', 'e bulloneria'] },
  { n: 2, x: 290, y: 311, lato: 's', ly: 250, righe: ['Altezza', 'di caduta'] },
  { n: 3, x: 500, y: 420, lato: 'd', ly: 380, righe: ['Spazio libero e', 'area di impatto'] },
  { n: 1, x: 210, y: 455, lato: 's', ly: 400, righe: ['Ancoraggi e', 'fondazioni'] },
];
---
<svg viewBox="-170 110 990 400" role="img" aria-labelledby="d4-t" class="disegno">
  <title id="d4-t">Ispezione secondo la UNI EN 1176: ancoraggi, altezza di caduta, spazio libero, usura</title>
  <g class="fantasma">
    <rect x="200" y="250" width="20" height="220" /><rect x="360" y="250" width="20" height="220" />
    <rect x="190" y="300" width="200" height="22" /><polygon points="290,150 400,250 180,250" />
    <path d="M390 315 C450 330 480 390 540 460" fill="none" />
    <line x1="120" y1="470" x2="620" y2="470" />
  </g>
  {punti.map((p, i) => {
    const bordo = p.lato === 's' ? 150 : 600;
    const tx = p.lato === 's' ? bordo - 14 : bordo + 14;
    const anchor = p.lato === 's' ? 'end' : 'start';
    const sx = p.lato === 's' ? bordo - 14 - 150 : bordo + 14;
    return (
      <g class="compare" style={`--i:${i}`}>
        <polyline class="richiamo" points={`${p.x},${p.y} ${p.x},${p.ly} ${bordo},${p.ly}`} fill="none" />
        <circle class="punto" cx={p.x} cy={p.y} r="15" />
        <text class="numero" x={p.x} y={p.y + 5} text-anchor="middle">{p.n}</text>
        <path class="spunta" d={`M${p.lato === 's' ? bordo - 10 : bordo + 2} ${p.ly - 30} l5 5 l9 -10`} />
        <text class="voce" x={tx} y={p.ly - 2} text-anchor={anchor}>{p.righe[0]}</text>
        <text class="voce" x={tx} y={p.ly + 22} text-anchor={anchor}>{p.righe[1]}</text>
      </g>
    );
  })}
</svg>
