<svg viewBox="30 60 560 440" role="img" aria-labelledby="d2-t" class="disegno">
  <title id="d2-t">Sezioni a confronto: palo in legno, tubo in acciaio e soluzione mista</title>
  <defs>
    <pattern id="tratteggio" width="10" height="10" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="10" stroke="#222018" stroke-width="1.2" opacity=".55" />
    </pattern>
  </defs>
  <g class="compare" style="--i:0">
    <rect class="legno" x="60" y="80" width="200" height="200" rx="10" />
    <path class="venatura disegna" pathLength="1" d="M80 120 C130 100 190 140 240 115" />
    <path class="venatura disegna" pathLength="1" d="M80 165 C140 145 180 190 240 160" />
    <path class="venatura disegna" pathLength="1" d="M80 210 C120 195 200 235 240 205" />
    <path class="venatura disegna" pathLength="1" d="M80 250 C130 235 180 270 240 250" />
    <text class="titolo-sezione" x="160" y="320" text-anchor="middle">Legno</text>
    <text class="nota" x="160" y="344" text-anchor="middle">calore, gioco naturale</text>
  </g>
  <g class="compare" style="--i:1">
    <circle class="acciaio" cx="460" cy="180" r="100" />
    <circle class="vuoto" cx="460" cy="180" r="78" />
    <text class="titolo-sezione" x="460" y="320" text-anchor="middle">Acciaio</text>
    <text class="nota" x="460" y="344" text-anchor="middle">meno manutenzione</text>
  </g>
  <g class="compare" style="--i:2">
    <rect class="legno" x="230" y="400" width="80" height="80" rx="6" />
    <circle class="acciaio" cx="350" cy="440" r="40" />
    <circle class="vuoto" cx="350" cy="440" r="30" />
    <polygon class="oro" points="290,385 300,391 300,403 290,409 280,403 280,391" />
    <text class="titolo-sezione" x="420" y="447">Misto</text>
  </g>
</svg>
