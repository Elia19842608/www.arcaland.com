---
import { contaPerLinea } from '../../lib/catalogo/conteggi';
import type { Prodotto } from '../../lib/catalogo/tipi';
import Icona from '../Icona.astro';

interface Props { prodotti: Prodotto[] }
const { prodotti } = Astro.props;
const linee = contaPerLinea(prodotti);
const inclusivi = prodotti.filter((p) => p.inclusivo).length;
const descrizioni: Record<string, string> = {
  giochi: 'Altalene, scivoli, giochi a molla, torri e composizioni Hexaplay.',
  'arredo-urbano': 'Panchine, tavoli, cestini, staccionate, bacheche e fioriere.',
  'percorsi-sportivi': 'Percorsi vita, attrezzi fitness all’aperto, agility dog.',
};
const prodottiN = (n: number) => (n === 1 ? '1 prodotto' : `${n} prodotti`);
---
<section class="contenitore linee" aria-labelledby="titolo-linee">
  <h2 id="titolo-linee">Cosa trovi nel catalogo</h2>
  <ol class="elenco">
    {linee.map((l, i) => (
      <li>
        <a href={`/prodotti?linea=${l.linea}`}>
          <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="nome">{l.etichetta}<span class="sr-only">, {prodottiN(l.n)}</span></span>
          <span class="desc">{descrizioni[l.linea]}</span>
          <span class="conto" aria-hidden="true">{prodottiN(l.n)}</span>
          <Icona nome="freccia" class="freccia" />
        </a>
      </li>
    ))}
  </ol>
  {inclusivi > 0 && <p class="inclusivi"><a href="/prodotti?inclusivo=1">Vedi i giochi inclusivi</a>, pensati perché tutti i bambini giochino insieme.</p>}
</section>

<style>
  .linee { margin-top: var(--spazio-8); }
  .elenco { list-style: none; margin: var(--spazio-5) 0 0; padding: 0; border-top: 1.5px solid var(--inchiostro); }
  .elenco a {
    display: grid; grid-template-columns: 3.5rem minmax(0, 1fr) minmax(0, 1.4fr) auto 1.5rem; align-items: baseline; gap: var(--spazio-4);
    padding: var(--spazio-5) var(--spazio-2); border-bottom: 1px solid var(--linea-forte); text-decoration: none;
    transition: background-color var(--durata) var(--curva);
  }
  .elenco a:hover { background: var(--carta-2); }
  .n { font-family: var(--font-titoli); font-weight: 600; color: var(--inchiostro-3); font-variant-numeric: tabular-nums; }
  .nome { font-family: var(--font-titoli); font-weight: 760; font-stretch: 88%; font-size: var(--titolo-m); letter-spacing: -0.03em; line-height: 1; }
  .desc { color: var(--inchiostro-2); }
  .conto { font-family: var(--font-titoli); font-weight: 650; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .elenco :global(.freccia) { width: 1.4rem; height: 1.4rem; align-self: center; transition: transform var(--durata) var(--curva); }
  .elenco a:hover :global(.freccia) { transform: translateX(4px); }
  .inclusivi { margin-top: var(--spazio-5); color: var(--inchiostro-2); }
  .inclusivi a { font-weight: 700; color: var(--inchiostro); }
  @media (max-width: 760px) {
    .elenco a { grid-template-columns: 2.25rem 1fr auto; row-gap: var(--spazio-2); }
    .desc { grid-column: 2 / -1; grid-row: 2; }
    .conto { grid-column: 2; grid-row: 3; }
    .elenco :global(.freccia) { grid-column: 3; grid-row: 1; }
  }
</style>
