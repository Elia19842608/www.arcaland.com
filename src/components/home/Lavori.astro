---
// Lavori già raccontati nelle news del sito Arcaland
const lavori = [
  { luogo: 'Collagna', prov: 'RE', cliente: 'Area pubblica', lavoro: 'Composizione modulare Hexaplay' },
  { luogo: 'Porto Viro', prov: 'RO', cliente: "Parco dell'Amicizia", lavoro: 'Torretta con scivolo e altalena' },
  { luogo: 'Villa Minozzo', prov: 'RE', cliente: 'Agriturismo Peschiera del Mulino', lavoro: 'Parco giochi in legno Hexaplay' },
  { luogo: 'Corbola', prov: 'RO', cliente: "Scuola dell'infanzia", lavoro: 'Nuovo gioco in legno' },
];
---
<section class="contenitore lavori" aria-labelledby="titolo-lavori">
  <div class="testa">
    <h2 id="titolo-lavori">Lavori recenti</h2>
    <p>Comuni, scuole, strutture turistiche: lo stesso metodo per ogni area.</p>
  </div>
  <table>
    <caption class="sr-only">Lavori recenti di Arcaland</caption>
    <thead><tr><th scope="col">Luogo</th><th scope="col">Committente</th><th scope="col">Lavoro</th></tr></thead>
    <tbody>
      {lavori.map((l) => (
        <tr><th scope="row">{l.luogo} <span>({l.prov})</span></th><td>{l.cliente}</td><td>{l.lavoro}</td></tr>
      ))}
    </tbody>
  </table>
  <ul class="fiducia" aria-label="Garanzie">
    <li><b>UNI EN 1176</b>Progettazione e ispezioni secondo la norma</li>
    <li><b>Gruppo Zennaro</b>Dal 2019, insieme ai marchi del legno del gruppo</li>
    <li><b>Reggio Emilia · Porto Viro</b>Sede commerciale e produzione</li>
  </ul>
</section>
<style>
  .lavori { margin-top: var(--spazio-8); }
  .testa { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: var(--spazio-3); }
  .testa p { color: var(--inchiostro-2); margin: 0; }
  table { width: 100%; border-collapse: collapse; margin-top: var(--spazio-5); }
  thead th { text-align: left; font-size: var(--testo-xs); font-weight: 700; color: var(--inchiostro-3); padding: 0 var(--spazio-3) var(--spazio-2) 0; border-bottom: 1.5px solid var(--inchiostro); }
  tbody th, tbody td { text-align: left; padding: var(--spazio-4) var(--spazio-3) var(--spazio-4) 0; border-bottom: 1px solid var(--linea-forte); vertical-align: top; }
  tbody th { font-family: var(--font-titoli); font-weight: 720; font-size: var(--testo-l); }
  tbody th span { font-weight: 500; color: var(--inchiostro-3); font-size: var(--testo-s); }
  tbody td { color: var(--inchiostro-2); }
  .fiducia { list-style: none; margin: var(--spazio-6) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--spazio-5); }
  .fiducia li { display: grid; gap: 0.2rem; padding-top: var(--spazio-3); border-top: 1.5px dashed var(--cielo-scuro); color: var(--inchiostro-2); font-size: var(--testo-s); }
  .fiducia b { font-family: var(--font-titoli); font-size: var(--testo-l); color: var(--inchiostro); }
  @media (max-width: 760px) {
    thead { display: none; }
    tbody tr { display: grid; padding: var(--spazio-3) 0; border-bottom: 1px solid var(--linea-forte); }
    tbody th, tbody td { border: 0; padding: 0.15rem 0; }
    .fiducia { grid-template-columns: 1fr; }
  }
</style>
