---
import Base from '../layouts/Base.astro';
import { emailRichieste } from '../lib/catalogo/carica';
const email = await emailRichieste();
---
<Base titolo="Richiedi un preventivo">
  <section class="contenitore pagina">
    <h1>Richiedi un preventivo</h1>
    <p>La richiesta di preventivo online arriva a breve. Scrivici a <a href={`mailto:${email}`}>{email}</a> con i codici dei prodotti che ti interessano e il comune dell'area: ti rispondiamo noi.</p>
    <a class="bottone bottone-secondario" href="/prodotti">Torna al catalogo</a>
  </section>
</Base>
<style>.pagina { padding-block: var(--spazio-8); }</style>
