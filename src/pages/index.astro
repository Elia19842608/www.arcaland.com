---
import Base from '../layouts/Base.astro';
import Racconto from '../components/home/Racconto.astro';
import Linee from '../components/home/Linee.astro';
import Hexaplay from '../components/home/Hexaplay.astro';
import Lavori from '../components/home/Lavori.astro';
import Chiusura from '../components/home/Chiusura.astro';
import { prodottiAttivi } from '../lib/catalogo/carica';

const prodotti = await prodottiAttivi();
---
<Base titolo="Arcaland" descrizione="Arcaland progetta aree gioco e arredo urbano in legno, acciaio e misti, ne segue la posa e le controlla con ispezioni periodiche secondo la UNI EN 1176.">
  <Racconto />
  <Linee prodotti={prodotti} />
  <Hexaplay />
  <Lavori />
  <Chiusura />
</Base>
